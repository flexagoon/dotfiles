[user]
	email = code@fxgn.dev
	name = flexagoon
	signingkey = {{ joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" }}
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[credential]
	helper = store
[init]
	defaultBranch = main
[alias]
	c = clone
	ca = commit -a
	graph = log --graph --all --oneline
    to = remote add origin
    uc = reset --soft HEAD^
    n = switch -c
[push]
	autoSetupRemote = true
[github]
	user = flexagoon
[rerere]
	enabled = true
[core]
    compression = 9
[http]
	cookiefile = {{ joinPath .chezmoi.homeDir ".config/git/gitcookies" }}
